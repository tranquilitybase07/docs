{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BillingOS",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@billingos.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.billingos.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "guides/session-tokens"
            ]
          },
          {
            "group": "Accept Payments",
            "pages": [
              "guides/show-a-pricing-page",
              "guides/accept-a-payment"
            ]
          },
          {
            "group": "Manage Billing",
            "pages": [
              "guides/manage-subscriptions",
              "guides/gate-features",
              "guides/track-usage",
              "guides/upgrade-nudges"
            ]
          },
          {
            "group": "Production",
            "pages": [
              "guides/handle-webhooks",
              "guides/go-live-checklist"
            ]
          }
        ]
      },
      {
        "tab": "React SDK",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "sdk/overview",
              "sdk/installation",
              "sdk/provider"
            ]
          },
          {
            "group": "Components",
            "pages": [
              "sdk/components/pricing-table",
              "sdk/components/checkout-modal",
              "sdk/components/customer-portal",
              "sdk/components/feature-gate",
              "sdk/components/usage-display",
              "sdk/components/upgrade-nudge",
              "sdk/components/upgrade-prompt"
            ]
          },
          {
            "group": "Hooks",
            "pages": [
              "sdk/hooks/use-subscription",
              "sdk/hooks/use-checkout",
              "sdk/hooks/use-feature",
              "sdk/hooks/use-entitlements",
              "sdk/hooks/use-track-usage",
              "sdk/hooks/use-products"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "sdk/client"
            ]
          }
        ]
      },
      {
        "tab": "Node SDK",
        "groups": [
          {
            "group": "Server SDK",
            "pages": [
              "server-sdk/overview",
              "server-sdk/session-tokens",
              "server-sdk/customers",
              "server-sdk/subscriptions",
              "server-sdk/entitlements",
              "server-sdk/usage"
            ]
          }
        ]
      },
      {
