        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Checkout",
            "pages": [
              "api-reference/checkout/create",
              "api-reference/checkout/status",
              "api-reference/checkout/confirm"
            ]
          },
          {
            "group": "Products",
            "pages": [
              "api-reference/products/list"
            ]
          },
          {
            "group": "Features & Entitlements",
            "pages": [
              "api-reference/features/check",
              "api-reference/features/entitlements",
              "api-reference/features/track-usage",
              "api-reference/features/usage-metrics"
