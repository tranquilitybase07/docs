{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BillingOS",
  "colors": {
    "primary": "#155dfc",
    "light": "#155dfc",
    "dark": "#155dfc"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@billingos.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.billingos.dev"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "guides/session-tokens",
              "guides/connect-stripe"
            ]
          },
          {
            "group": "Accept Payments",
            "pages": ["guides/show-a-pricing-page", "guides/accept-a-payment"]
          },
          {
            "group": "Manage Billing",
            "pages": [
              "guides/manage-subscriptions",
              "guides/gate-features",
              "guides/track-usage",
              "guides/upgrade-nudges"
            ]
          },
          {
            "group": "Migrate",
            "pages": ["guides/stripe-migration"]
          },
          {
            "group": "Production",
            "pages": ["guides/go-live-checklist"]
          }
        ]
      },
      {
        "tab": "React SDK",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["sdk/overview", "sdk/installation", "sdk/provider"]
          },
          {
            "group": "Components",
            "pages": [
              "sdk/components/pricing-table",
              "sdk/components/checkout-modal",
              "sdk/components/customer-portal",
              "sdk/components/feature-gate",
              "sdk/components/usage-display",
              "sdk/components/upgrade-nudge",
              "sdk/components/upgrade-prompt"
            ]
          },
          {
            "group": "Hooks",
            "pages": [
              "sdk/hooks/use-subscription",
              "sdk/hooks/use-checkout",
              "sdk/hooks/use-feature",
              "sdk/hooks/use-entitlements",
              "sdk/hooks/use-track-usage",
              "sdk/hooks/use-products"
            ]
          },
          {
            "group": "Advanced",
            "pages": ["sdk/client"]
          }
        ]
      },
      {
        "tab": "Node SDK",
        "groups": [
          {
            "group": "Server SDK",
            "pages": [
              "server-sdk/overview",
              "server-sdk/session-tokens",
              "server-sdk/customers",
              "server-sdk/subscriptions",
              "server-sdk/entitlements",
              "server-sdk/usage"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/tranquilitybase07/billingos",
          "icon": "github"
        }
      ]
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "cursor"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/BillingOS",
      "github": "https://github.com/tranquilitybase07/billingos"
    }
  }
}
